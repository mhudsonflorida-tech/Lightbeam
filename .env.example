# ─── Outreach.io OAuth Credentials ───────────────────────────────────────────
# Get these from your Outreach app at https://developers.outreach.io
OUTREACH_CLIENT_ID=your_outreach_client_id
OUTREACH_CLIENT_SECRET=your_outreach_client_secret
OUTREACH_REDIRECT_URI=http://localhost:3000/callback

# Long-lived access token obtained via OAuth flow
OUTREACH_ACCESS_TOKEN=your_outreach_access_token
# Optional: used to auto-refresh expired access tokens
OUTREACH_REFRESH_TOKEN=your_outreach_refresh_token

# The Outreach prospect custom field where physical location will be stored.
# Must match a custom attribute key configured in your Outreach admin
# (e.g. "custom1" through "custom20", or a named attribute slug).
OUTREACH_LOCATION_FIELD=custom1

# ─── LinkedIn Sales Navigator OAuth Credentials ───────────────────────────────
# Requires Sales Navigator API access via LinkedIn's SNAP partner program.
# https://business.linkedin.com/sales-solutions/sales-navigator-api-program
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# OAuth 2.0 access token with r_liteprofile + r_sales_nav_profile scopes
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
# Optional: used to auto-refresh expired tokens
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token

# ─── Sync Settings ────────────────────────────────────────────────────────────
# How many prospects to fetch per Outreach API page (max 100)
SYNC_BATCH_SIZE=50
# Milliseconds to wait between API calls to respect rate limits
RATE_LIMIT_DELAY_MS=500
# Maximum concurrent LinkedIn lookups at one time
SYNC_CONCURRENCY=5
